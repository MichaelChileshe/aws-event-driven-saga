# Project 17 environment. Load it in EVERY new terminal:   source ~/p17/env.sh
# Values saved during the build are appended to the bottom of this file automatically.

export AWS_PAGER=""
export AWS_DEFAULT_REGION=us-east-1
export REGION=us-east-1
export P17="$HOME/p17"

# save NAME VALUE  -> exports it now AND appends it to this file, so a new terminal gets it back.
save() {
  if [ -z "${2:-}" ] || [ "$2" = "None" ]; then
    echo "ERROR: $1 came back empty. The command inside save failed - read the error above, fix it, run it again."
    return 1
  fi
  export "$1=$2"
  echo "export $1=\"$2\"" >> "$P17/env.sh"
  echo "saved $1=$2"
}

# ---- values saved during the build appear below this line ----
